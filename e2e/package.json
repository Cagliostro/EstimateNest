{
  "name": "@estimatenest/e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "echo 'E2E tests skipped: use npm run test:e2e to run'",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep smoke",
    "lint": "tsc --noEmit",
    "postinstall": "npx playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@estimatenest/shared": "file:../packages/shared"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.4.5"
  }
}
