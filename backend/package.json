{
  "name": "@estimatenest/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch",
    "dev:server": "tsx src/local-server.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1124.0",
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/lib-dynamodb": "^3.1124.0",
    "@estimatenest/shared": "file:../packages/shared",
    "aws-xray-sdk": "^3.5.0",
    "uuid": "^11.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "body-parser": "^2.3.0",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "globals": "^15.0.0",
    "tsup": "^8.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
